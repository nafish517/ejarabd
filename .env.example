# EjaraBD (ইজারাবিডি) Environment Configuration Example
# Copy this file to .env and configure appropriate values.
# NEVER commit credentials or .env to version control.

# Email Provider Configuration ('smtp' or 'mock')
EMAIL_PROVIDER=smtp

# Development Safety Guard:
# When true, emails are NOT delivered to real clients. Only safe test emails are allowed.
EMAIL_DEV_MODE=true
SAFE_TEST_EMAIL=ejarabd@gmail.com

# SMTP Server Settings (e.g., smtp.gmail.com, Port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Sender Identity
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=EjaraBD

# SMTP Connection Options
SMTP_USE_TLS=true
SMTP_TIMEOUT=10

